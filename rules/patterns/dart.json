{
  "language": "dart",
  "suffixes": [".dart"],
  "exclude_suffixes": [".g.dart", ".freezed.dart", ".gr.dart", ".mocks.dart"],
  "patterns": [
    {"id": "fold-not-unwrap", "regex": "\\.isLeft\\(\\)|\\.isRight\\(\\)|\\.isSome\\(\\)|\\.isNone\\(\\)", "message": "consume wrapped values with .fold() instead of unwrapping", "rule": "fp-core branching 4 / fp-dartz either 2"},
    {"id": "no-else", "regex": "\\belse\\b", "message": "no else branches: use switch expressions or fold", "rule": "fp-core branching 1-2"},
    {"id": "no-var", "regex": "\\bvar\\s", "message": "no var: use final/const", "rule": "fp-dart-style usage 1"},
    {"id": "no-try-catch", "regex": "\\btry\\s*\\{", "message": "no try/catch in business logic: wrap effects in Task(...).attempt(); justified only in data-source internals", "rule": "fp-dartz task 1"},
    {"id": "no-tuple-return", "regex": "\\bTuple[0-9]", "message": "no Tuple returns: use a record or named class", "rule": "fp-dartz types 1"},
    {"id": "no-async-void", "regex": "void\\s+\\w+\\s*\\([^)]*\\)\\s*async\\b", "message": "no async void: return Future<void>", "rule": "fp-dart-style asynchrony 1"},
    {"id": "no-for-loop", "regex": "\\bfor\\s*\\(|\\bwhile\\s*\\(", "message": "prefer map/where/fold/expand over imperative loops", "rule": "fp-core data 4 / fp-dart-style usage 2"},
    {"id": "no-throw-domain", "regex": "\\bthrow\\s+(?!(UnimplementedError|UnsupportedError|AssertionError)\\b)", "message": "errors are values: return Either<Failure, T> instead of throwing", "rule": "fp-core errors 1 / fp-dartz either 1"},
    {"id": "no-reassignment", "regex": "^\\s*[a-z_]\\w*(?:\\.\\w+)*\\s*[-+*/%]?=[^=>]", "message": "no reassignment or compound assignment: bindings are final", "rule": "fp-core data 1"},
    {"id": "no-mutable-field", "regex": "^\\s*(?!(?:final|const|var|static|return|await|yield|throw|if|for|while|switch|do|break|continue|else|assert|new|library|part|typedef|external|late\\s+final)\\b)[A-Za-z_]\\w*(?:<[^;=]*>)?\\??\\s+[a-z_]\\w*\\s*(?:=[^;]*)?;", "message": "declarations must be final/const: mutable fields and unguarded locals are prohibited", "rule": "fp-dart-style design 1-2 / usage 1"},
    {"id": "no-late", "regex": "\\blate\\s+(?!final\\b)", "message": "avoid late non-final bindings", "rule": "fp-dart-style design 1"},
    {"id": "no-collection-mutation", "regex": "\\.(add|addAll|remove|removeAt|clear|sort)\\s*\\(", "message": "collections are immutable: transform instead of mutating", "rule": "fp-core data 1 / fp-dartz types 2"},
    {"id": "no-stateful-widget", "regex": "extends\\s+StatefulWidget|\\bChangeNotifier\\b|\\bValueNotifier\\b", "message": "avoid StatefulWidget/ChangeNotifier/ValueNotifier: use flutter_hooks or a state container", "rule": "fp-flutter widget 4"},
    {"id": "no-manual-listen", "regex": "\\.listen\\s*\\(", "message": "compose streams declaratively; .listen() only at the UI edge with guaranteed disposal", "rule": "fp-rxdart stream 1 / memory 1"},
    {"id": "no-unbounded-replay", "regex": "ReplaySubject\\s*<[^>]*>\\s*\\(\\s*\\)", "message": "ReplaySubject requires an explicit maxSize bound", "rule": "fp-rxdart memory 2"}
  ]
}
