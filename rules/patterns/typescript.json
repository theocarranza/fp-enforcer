{
  "language": "typescript",
  "suffixes": [".ts", ".tsx"],
  "exclude_suffixes": [".d.ts"],
  "patterns": [
    {"id": "no-let", "regex": "\\blet\\s", "message": "const only: no let, no mutation", "rule": "fp-typescript 1"},
    {"id": "no-var", "regex": "\\bvar\\s", "message": "const only: no var", "rule": "fp-typescript 1"},
    {"id": "no-else", "regex": "\\belse\\b", "message": "no else branches: use expression lookups or pattern-matched returns", "rule": "fp-core branching 1-2"},
    {"id": "no-throw-internal", "regex": "\\bthrow\\s+(?!new\\s+(HttpsError|UnimplementedError|UnsupportedError)\\b)", "message": "errors are values internally; typed errors only at the outermost edge", "rule": "fp-typescript 5"},
    {"id": "no-or-fallback", "regex": "\\w+\\s*\\|\\|\\s*[\\d{'\"\\[]", "message": "use ?? for absence: || swallows valid falsy values", "rule": "fp-typescript 3"},
    {"id": "no-for-loop", "regex": "\\bfor\\s*\\(|\\bwhile\\s*\\(", "message": "use map/filter/reduce pipelines over loops", "rule": "fp-typescript 8 / fp-core data 4"},
    {"id": "no-collection-mutation", "regex": "\\.(push|pop|splice|shift|unshift|sort|reverse)\\s*\\(", "message": "no array mutation: use spread and pure transformations", "rule": "fp-typescript 1 & 6"},
    {"id": "no-field-write", "regex": "\\b(?!this\\b)\\w+\\.\\w+\\s*=[^=>]", "message": "no object mutation: partial updates travel as patch objects", "rule": "fp-typescript 6"}
  ]
}
